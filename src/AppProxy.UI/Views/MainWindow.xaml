<ui:FluentWindow x:Class="AppProxy.UI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AppProxy - 应用级代理注入启动器"
                 Width="1240"
                 Height="780"
                 MinWidth="980"
                 MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="pack://application:,,,/Assets/AppProxy.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="AppProxy">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="16"
                              Height="16"
                              RenderOptions.BitmapScalingMode="HighQuality"
                              Source="pack://application:,,,/Assets/AppProxy.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Shell -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail -->
            <Border Grid.Column="0"
                    Padding="14,12,14,14"
                    Background="{DynamicResource NavRailBackgroundBrush}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <DockPanel>
                    <!-- Brand Header -->
                    <Border DockPanel.Dock="Top"
                            CornerRadius="11"
                            Padding="12,11"
                            Margin="0,0,0,14"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38"
                                    Height="38"
                                    CornerRadius="9"
                                    Margin="0,0,11,0"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                    Background="{DynamicResource AppAccentSoftBrush}">
                                <Image Source="pack://application:,,,/Assets/AppProxy.png"
                                       Width="28"
                                       Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="AppProxy" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource CompactPillBadgeStyle}"
                                            Margin="6,0,0,0">
                                        <TextBlock Text="{Binding AppVersionDisplay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="进程级透明代理引擎"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section Caption -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="工作区"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="8,0,0,4"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- Navigation Items -->
                    <ListBox DockPanel.Dock="Top"
                             SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavRailItemStyle}"
                             Background="Transparent"
                             BorderThickness="0">

                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Apps24" FontSize="17" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="应用管理" VerticalAlignment="Center" FontWeight="Medium" />
                                <Border Grid.Column="2"
                                        CornerRadius="10"
                                        Padding="7,1.5"
                                        Background="{DynamicResource SemanticNeutralBgBrush}">
                                    <TextBlock Text="{Binding Apps.Count}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Globe24" FontSize="17" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="代理节点" VerticalAlignment="Center" FontWeight="Medium" />
                                <Border Grid.Column="2"
                                        CornerRadius="10"
                                        Padding="7,1.5"
                                        Background="{DynamicResource SemanticNeutralBgBrush}">
                                    <TextBlock Text="{Binding Proxies.Count}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Pulse24" FontSize="17" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="实时监控" VerticalAlignment="Center" FontWeight="Medium" />
                                <Border Grid.Column="2"
                                        CornerRadius="10"
                                        Padding="7,1.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding ActiveConnectionsCount}"
                                               FontSize="11"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Settings24" FontSize="17" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="系统设置" VerticalAlignment="Center" FontWeight="Medium" />
                                <Ellipse Grid.Column="2"
                                         Width="7"
                                         Height="7"
                                         Margin="6,0,2,0"
                                         VerticalAlignment="Center"
                                         ToolTip="{Binding XrayCoreBadgeText}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{DynamicResource SemanticSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Fill" Value="{DynamicResource SemanticErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                        </ListBoxItem>
                    </ListBox>

                    <!-- Bottom Engine Telemetry Card -->
                    <Border DockPanel.Dock="Bottom"
                            VerticalAlignment="Bottom"
                            CornerRadius="11"
                            Padding="13"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SemanticSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="引擎待命" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                        <Setter Property="Text" Value="桥接运行中" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <ui:Button Content="监控"
                                           Appearance="Transparent"
                                           FontSize="11"
                                           Padding="7,2.5"
                                           HorizontalAlignment="Right"
                                           Click="OnOpenMonitorClick" />
                            </Grid>

                            <TextBlock Text="{Binding BridgeStatusText}"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Margin="0,6,0,10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource MiniMetricTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="活跃实例" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveBridgesCount}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource MiniMetricTileStyle}">
                                    <StackPanel>
                                        <TextBlock Text="活跃连接" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding ActiveConnectionsCount}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Page Host -->
            <Grid Grid.Column="1" Margin="24,16,24,16">

                <!-- PAGE 0: Applications -->
                <Grid x:Name="AppsPageRoot"
                      AllowDrop="True"
                      DragOver="OnAppsDragOver"
                      DragLeave="OnAppsDragLeave"
                      Drop="OnAppsDrop">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="应用管理" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
                                <Button Padding="0"
                                        Margin="10,0,0,0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Command" Value="{Binding OpenProxiesPageCommand}" />
                                            <Setter Property="ToolTip" Value="前往「代理节点」查看或管理上游代理" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="PillHost" Background="Transparent">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PillHost" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                    <Setter Property="Command" Value="{Binding OpenMonitorPageCommand}" />
                                                    <Setter Property="ToolTip" Value="点击前往「实时监控」查看运行中的桥接与连接" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Border Padding="8,2.5" CornerRadius="6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticNeutralBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6.5" Height="6.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource SemanticSuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Proxies.Count, StringFormat='可用代理 {0} 个'}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                                <Setter Property="Text" Value="{Binding ActiveBridgesCount, StringFormat='运行中 · {0} 个桥接'}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="配置目标应用与隔离策略，启动时自动通过 Early-Bird APC 注入接管 TCP、Fake-IP DNS 与子进程树"
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Content="添加应用"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary"
                                   Click="OnAddAppClick"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Row 1: Compact 4-Column Apps Overview Strip -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- KPI 1: App Count & Arch Breakdown -->
                        <Border Grid.Column="0"
                                CornerRadius="10"
                                Padding="12,9"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="已配置应用" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Apps.Count, StringFormat='{}{0} 个应用'}" FontSize="14" FontWeight="Bold" Margin="0,3,0,2" />
                                <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding AppArchBreakdownText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveAppFilter}" Value="True">
                                                    <Setter Property="Text" Value="{Binding FilteredAppCount, StringFormat='当前筛选显示 {0} 个'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- KPI 2: Proxy Binding Overview -->
                        <Button Grid.Column="2"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Cursor="Hand"
                                ToolTip="点击前往「代理节点」管理上游节点"
                                Command="{Binding OpenProxiesPageCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TileHost"
                                            CornerRadius="10"
                                            Padding="12,9"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileHost" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="代理绑定" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding BoundProxyAppsCount, StringFormat='{}{0} 个已绑定'}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,3,0,2"
                                           Foreground="{DynamicResource AppAccentBrush}" />
                                <TextBlock Text="{Binding AppBindingSummaryText}"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- KPI 3: Isolation & DNS Policies -->
                        <Border Grid.Column="4"
                                CornerRadius="10"
                                Padding="12,9"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="DNS 与隔离策略" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding AppPolicySummaryText}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,3,0,2"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource SemanticTealBrush}" />
                                <TextBlock Text="支持系统代理与 TUN 隔离"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- KPI 4: Live Bridge Runtime -->
                        <Button Grid.Column="6"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Cursor="Hand"
                                ToolTip="点击前往「实时监控」查看活跃桥接与连接"
                                Command="{Binding OpenMonitorPageCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TileHost" CornerRadius="10" Padding="12,9" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileHost" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="实时运行态" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ActiveBridgesCount, StringFormat='{}{0} 个活跃桥接'}" FontSize="14" FontWeight="Bold" Margin="0,3,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ActiveConnectionsCount, StringFormat='当前活跃连接 {0} 条'}"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Row 2: Unified Filter Toolbar -->
                    <Border Grid.Row="2" Style="{StaticResource ToolbarStripStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="170" MaxWidth="290" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="搜索应用名称、路径或代理..."
                                            Icon="{ui:SymbolIcon Search24}"
                                            VerticalAlignment="Center" />

                                <ComboBox Grid.Column="1"
                                          Width="136"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding AppBindingFilter, Mode=TwoWay}"
                                          ToolTip="按绑定策略筛选">
                                    <ComboBoxItem Content="全部绑定" Tag="All" />
                                    <ComboBoxItem Content="已绑定代理" Tag="Proxied" />
                                    <ComboBoxItem Content="直连 (Direct)" Tag="Direct" />
                                </ComboBox>

                                <ComboBox Grid.Column="2"
                                          Width="112"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding AppArchFilter, Mode=TwoWay}"
                                          ToolTip="按架构筛选">
                                    <ComboBoxItem Content="全部架构" Tag="All" />
                                    <ComboBoxItem Content="x64" Tag="x64" />
                                    <ComboBoxItem Content="x86" Tag="x86" />
                                </ComboBox>

                                <ui:Button Grid.Column="3"
                                           Content="重置"
                                           Icon="{ui:SymbolIcon Broom24}"
                                           Appearance="Secondary"
                                           Margin="8,0,0,0"
                                           Padding="10,6"
                                           Command="{Binding ResetAppFiltersCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveAppFilter}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>

                            <Border Grid.Column="1"
                                    Style="{StaticResource CompactPillBadgeStyle}"
                                    Margin="12,0,0,0"
                                    Padding="9,4">
                                <TextBlock Text="支持直接拖入 .exe 或 .lnk 快捷方式"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 3: Empty State Dropzone Card -->
                    <Grid Grid.Row="3" Margin="0,8,0,12">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Border CornerRadius="12"
                                Padding="28,32"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                                <Border Width="52"
                                        Height="52"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource AppAccentSoftBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource AppAccentBorderBrush}">
                                    <ui:SymbolIcon Symbol="Apps24" FontSize="24" Foreground="{DynamicResource AppAccentBrush}" />
                                </Border>
                                <TextBlock Text="还没有配置任何应用"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,6" />
                                <TextBlock Text="将桌面上的 .exe 可执行文件或 .lnk 快捷方式直接拖入此窗口，或点击下方按钮手动添加并绑定代理节点。"
                                           FontSize="12.5"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:Button Content="选择应用或快捷方式"
                                           Icon="{ui:SymbolIcon FolderOpen24}"
                                           Appearance="Primary"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,0"
                                           Click="OnAddAppClick" />
                            </StackPanel>
                        </Border>
                        <Rectangle Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="4 3"
                                   RadiusX="12"
                                   RadiusY="12"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <!-- Row 4: Empty Filter State -->
                    <Border Grid.Row="4"
                            Margin="0,8,0,12"
                            CornerRadius="12"
                            Padding="24,28"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowAppFilterEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="没有符合筛选条件的应用"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="请尝试调整搜索关键词，或切换绑定策略与架构筛选。"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Content="重置筛选条件"
                                       Icon="{ui:SymbolIcon Broom24}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"
                                       Command="{Binding ResetAppFiltersCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Row 5: App Cards List -->
                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <ItemsControl ItemsSource="{Binding FilteredApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InteractiveCardStyle}" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon Container -->
                                            <Border Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="10"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource SubtleDividerBrush}"
                                                    Background="{DynamicResource IconContainerBgBrush}">
                                                <Grid>
                                                    <Image Source="{Binding Icon}"
                                                           Width="28"
                                                           Height="28"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <ui:SymbolIcon Symbol="Apps24"
                                                                   FontSize="20"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Grid>
                                            </Border>

                                            <!-- App Metadata & Capability Pills -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- Row 1: Title + Arch + Bound Proxy -->
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="260"
                                                               VerticalAlignment="Center" />

                                                    <!-- Architecture Pill -->
                                                    <Border Margin="8,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Background" Value="{DynamicResource SemanticInfoBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticInfoBorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DetectedArch}" Value="x86">
                                                                        <Setter Property="Background" Value="{DynamicResource SemanticPurpleBgBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticPurpleBorderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DetectedArch}" FontSize="10.5" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticInfoBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DetectedArch}" Value="x86">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticPurpleBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Bound Proxy Pill -->
                                                    <Border Margin="6,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProxyProfileId}" Value="{x:Null}">
                                                                        <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticNeutralBorderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding BoundProxyName}" FontSize="10.5" FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ProxyProfileId}" Value="{x:Null}">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Row 2: Exe Path -->
                                                <TextBlock Text="{Binding ExePath}"
                                                           FontFamily="Consolas"
                                                           FontSize="11.5"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ExePath}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                                <!-- Row 3: WrapPanel Capability Badges -->
                                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <!-- Fake-IP Pill -->
                                                    <Border Margin="0,0,6,2"
                                                            Background="{DynamicResource SemanticTealBgBrush}"
                                                            BorderBrush="{DynamicResource SemanticTealBorderBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RemoteDns}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Fake-IP"
                                                                   FontSize="10.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource SemanticTealBrush}" />
                                                    </Border>

                                                    <!-- Isolated Profile Pill -->
                                                    <Border Margin="0,0,6,2"
                                                            Background="{DynamicResource SemanticPurpleBgBrush}"
                                                            BorderBrush="{DynamicResource SemanticPurpleBorderBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EffectiveIsolateProfileDir}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="独立配置目录"
                                                                   FontSize="10.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource SemanticPurpleBrush}" />
                                                    </Border>

                                                    <!-- Non-isolated System Proxy Indicator -->
                                                    <Border Margin="0,0,6,2"
                                                            Background="{DynamicResource SemanticWarningBgBrush}"
                                                            BorderBrush="{DynamicResource SemanticWarningBorderBrush}"
                                                            ToolTip="当前未启用「忽略系统代理」，可能受 Windows 系统代理影响">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IgnoreSystemProxy}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="跟随系统代理"
                                                                   FontSize="10.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource SemanticWarningBrush}" />
                                                    </Border>

                                                    <!-- Custom Arguments Indicator Pill -->
                                                    <Border Margin="0,0,6,2" ToolTip="{Binding Arguments}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasArguments}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="启动参数"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>

                                                    <!-- Max Instances Pill -->
                                                    <Border Margin="0,0,6,2"
                                                            ToolTip="最大允许同时运行的实例数（无论是否通过代理启动均计入）">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticNeutralBorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasCustomMaxInstances}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SemanticWarningBgBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticWarningBorderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding MaxInstancesDisplay}" FontSize="10.5" FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasCustomMaxInstances}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Quick Proxy Switch + Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <ComboBox Width="172"
                                                          Margin="0,0,8,0"
                                                          ItemsSource="{Binding DataContext.Proxies, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding ProxyProfileId, Mode=TwoWay}"
                                                          SelectionChanged="OnQuickProxyChanged"
                                                          ToolTip="快速切换绑定代理" />
                                                <ui:Button Content="启动代理"
                                                           Icon="{ui:SymbolIcon Play24}"
                                                           Appearance="Primary"
                                                           Padding="10,6"
                                                           Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                                <Border Style="{StaticResource ToolbarVerticalDividerStyle}" />
                                                <ui:Button Icon="{ui:SymbolIcon Desktop24}"
                                                           Appearance="Secondary"
                                                           Padding="8,6"
                                                           Margin="0,0,4,0"
                                                           ToolTip="创建桌面快捷方式（双击无需打开 UI 即可代理启动）"
                                                           Command="{Binding DataContext.CreateDesktopShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                                           Appearance="Secondary"
                                                           Padding="8,6"
                                                           Margin="0,0,4,0"
                                                           ToolTip="编辑应用配置"
                                                           Click="OnEditAppClick" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                           Appearance="Secondary"
                                                           Padding="8,6"
                                                           ToolTip="删除应用"
                                                           Command="{Binding DataContext.DeleteAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Drag & Drop Visual Overlay -->
                    <Grid x:Name="AppsDropOverlay"
                          Grid.RowSpan="6"
                          Visibility="Collapsed"
                          IsHitTestVisible="False">
                        <Border CornerRadius="12" Background="{DynamicResource DropzoneBackgroundBrush}" />
                        <Rectangle Stroke="{DynamicResource AppAccentBrush}"
                                   StrokeThickness="2"
                                   StrokeDashArray="5 3"
                                   RadiusX="12"
                                   RadiusY="12" />
                        <Border CornerRadius="12"
                                Padding="24,18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AppAccentBorderBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Add24"
                                               FontSize="30"
                                               Foreground="{DynamicResource AppAccentBrush}"
                                               HorizontalAlignment="Center" />
                                <TextBlock Text="松开鼠标以导入应用或快捷方式"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,2"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="自动识别 PE 架构、提取图标并绑定默认代理节点"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- PAGE 1: Proxies -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="代理节点" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
                                <Button Padding="0"
                                        Margin="10,0,0,0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        ToolTip="点击前往「系统设置 → Xray-core 托管内核」配置或更新"
                                        Command="{Binding OpenSettingsPageCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="PillHost" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="PillHost" Property="Opacity" Value="0.85" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Border Padding="8,2.5" CornerRadius="6" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticNeutralBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticErrorBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticErrorBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6.5" Height="6.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                                <Setter Property="Fill" Value="{DynamicResource SemanticSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                                <Setter Property="Fill" Value="{DynamicResource SemanticErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Xray 未配置（仅原生代理）" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                                <Setter Property="Text" Value="{Binding XrayCoreBadgeText, StringFormat='Xray {0}'}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                                <Setter Property="Text" Value="Xray 内核异常（点击检查）" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding ProxyPageSubtitle}"
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="批量导入"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Appearance="Secondary"
                                       Margin="0,0,8,0"
                                       Click="OnBatchImportProxiesClick" />
                            <ui:Button Content="添加节点"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Appearance="Primary"
                                       Click="OnAddProxyClick" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Compact 4-Column Proxy Overview Strip -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Proxies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- KPI 1: Total & Protocol Breakdown -->
                        <Border Grid.Column="0"
                                CornerRadius="10"
                                Padding="12,9"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="节点总数" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Proxies.Count, StringFormat='{}{0} 个节点'}" FontSize="14" FontWeight="Bold" Margin="0,3,0,2" />
                                <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding ProxyProtocolBreakdownText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveProxyFilter}" Value="True">
                                                    <Setter Property="Text" Value="{Binding FilteredProxyCount, StringFormat='当前筛选显示 {0} 个'}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- KPI 2: Connectivity & Fastest Latency -->
                        <Border Grid.Column="2" CornerRadius="10" Padding="12,9" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvailableProxyCount}" Value="0">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="连通测速" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ProxyLatencySummaryText}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,3,0,2"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AvailableProxyCount}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TestProbeHost, StringFormat='探测目标: {0}'}"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- KPI 3: Exit IP Detection -->
                        <Border Grid.Column="4" CornerRadius="10" Padding="12,9" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExitDetectedProxyCount}" Value="0">
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="落地出口" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ExitDetectedProxyCount, StringFormat='{}{0} 个已识别'}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,3,0,2">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SemanticTealBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExitDetectedProxyCount}" Value="0">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="点击卡片出口徽章可快速复制 IP"
                                           FontSize="10.5"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- KPI 4: Xray-core Runtime (Clickable to Settings) -->
                        <Button Grid.Column="6"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Cursor="Hand"
                                ToolTip="前往系统设置管理 Xray-core 内核"
                                Command="{Binding OpenSettingsPageCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TileHost" CornerRadius="10" Padding="12,9" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticErrorBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticErrorBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TileHost" Property="Opacity" Value="0.88" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="Xray-core 内核" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding XrayCoreBadgeText}" FontSize="14" FontWeight="Bold" Margin="0,3,0,2" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="点击前往设置配置 / 下载" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsXrayCoreAvailable}" Value="True">
                                                    <Setter Property="Text" Value="支持 VLESS / REALITY / TLS" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Row 2: Unified Proxy Select, Filter, Sort & Action Toolbar -->
                    <Border Grid.Row="2" Style="{StaticResource ToolbarStripStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="145" MaxWidth="250" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding AreAllVisibleProxiesSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="2,0,10,0"
                                          Padding="4,0,0,0"
                                          Content="全选"
                                          FontSize="12"
                                          ToolTip="全选或取消全选当前列表中的节点" />

                                <ui:TextBox Grid.Column="1"
                                            Text="{Binding ProxySearchText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="搜索名称、地址、IP 或地区..."
                                            Icon="{ui:SymbolIcon Search24}"
                                            VerticalAlignment="Center" />

                                <ComboBox Grid.Column="2"
                                          Width="124"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding ProxyProtocolFilter, Mode=TwoWay}"
                                          ToolTip="按协议筛选">
                                    <ComboBoxItem Content="全部协议" Tag="All" />
                                    <ComboBoxItem Content="SOCKS5" Tag="Socks5" />
                                    <ComboBoxItem Content="HTTP" Tag="Http" />
                                    <ComboBoxItem Content="HTTPS" Tag="Https" />
                                    <ComboBoxItem Content="VLESS" Tag="Vless" />
                                </ComboBox>

                                <ComboBox Grid.Column="3"
                                          Width="128"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding ProxySortMode, Mode=TwoWay}"
                                          ToolTip="节点排序方式">
                                    <ComboBoxItem Content="默认顺序" Tag="Default" />
                                    <ComboBoxItem Content="延迟优先" Tag="Latency" />
                                    <ComboBoxItem Content="名称排序" Tag="Name" />
                                </ComboBox>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <ui:Button Content="全部测速"
                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                           Appearance="Secondary"
                                           Margin="0,0,6,0"
                                           Command="{Binding TestAllProxiesCommand}" />
                                <ui:Button Content="全部查出口"
                                           Icon="{ui:SymbolIcon Globe24}"
                                           Appearance="Secondary"
                                           Command="{Binding DetectAllProxiesExitIpCommand}" />
                                <Border Style="{StaticResource ToolbarVerticalDividerStyle}" />
                                <ui:Button Content="{Binding ExportProxyButtonText}"
                                           Icon="{ui:SymbolIcon ArrowUpload24}"
                                           ToolTip="打开导出向导（支持勾选节点、URI 列表与 JSON 格式）"
                                           Click="OnExportProxiesClick">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Appearance" Value="Secondary" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedProxies}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 3: Contextual Multi-Select Action Bar -->
                    <Border Grid.Row="3"
                            CornerRadius="9"
                            Padding="12,7"
                            Margin="0,0,0,10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AppAccentBorderBrush}"
                            Background="{DynamicResource AppAccentSoftBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedProxies}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource AppAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <Run Text="已选中 " />
                                    <Run Text="{Binding SelectedProxyCount, Mode=OneWay}" Foreground="{DynamicResource AppAccentBrush}" />
                                    <Run Text=" 个代理节点" />
                                </TextBlock>
                                <ui:Button Content="取消选择"
                                           Icon="{ui:SymbolIcon Dismiss24}"
                                           Appearance="Transparent"
                                           FontSize="11.5"
                                           Padding="8,3"
                                           Margin="8,0,0,0"
                                           Command="{Binding ClearProxySelectionCommand}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:Button Content="导出选中"
                                           Icon="{ui:SymbolIcon ArrowUpload24}"
                                           Appearance="Primary"
                                           Padding="10,5"
                                           Margin="0,0,6,0"
                                           Click="OnExportProxiesClick" />
                                <ui:Button Content="测速选中"
                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                           Appearance="Secondary"
                                           Padding="10,5"
                                           Margin="0,0,6,0"
                                           Command="{Binding TestSelectedProxiesCommand}" />
                                <ui:Button Content="查出口选中"
                                           Icon="{ui:SymbolIcon Globe24}"
                                           Appearance="Secondary"
                                           Padding="10,5"
                                           Margin="0,0,6,0"
                                           Command="{Binding DetectSelectedProxiesExitIpCommand}" />
                                <ui:Button Content="删除选中"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Appearance="Secondary"
                                           Padding="10,5"
                                           Click="OnDeleteSelectedProxiesClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 4: Empty Proxy State -->
                    <Border Grid.Row="4"
                            Margin="0,8,0,12"
                            CornerRadius="12"
                            Padding="28,32"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Proxies.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                            <Border Width="52"
                                    Height="52"
                                    CornerRadius="12"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource SemanticInfoBgBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource SemanticInfoBorderBrush}">
                                <ui:SymbolIcon Symbol="Globe24" FontSize="24" Foreground="{DynamicResource SemanticInfoBrush}" />
                            </Border>
                            <TextBlock Text="暂无可用代理节点"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,6" />
                            <TextBlock Text="点击“添加节点”可直接粘贴单条 socks5://、http(s)://、vless:// 或 host:port:user:pass 链接快速填充，也可通过“批量导入”一次添加多个节点。"
                                       FontSize="12.5"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <ui:Button Content="添加代理节点"
                                           Icon="{ui:SymbolIcon Add24}"
                                           Appearance="Primary"
                                           Margin="0,0,8,0"
                                           Click="OnAddProxyClick" />
                                <ui:Button Content="批量导入"
                                           Icon="{ui:SymbolIcon ArrowDownload24}"
                                           Appearance="Secondary"
                                           Click="OnBatchImportProxiesClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Row 5: Empty Filter Result State -->
                    <Border Grid.Row="5"
                            Margin="0,8,0,12"
                            CornerRadius="12"
                            Padding="24,28"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowProxyFilterEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock Text="没有符合筛选条件的代理节点"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="请尝试调整搜索关键词或切换协议筛选条件。"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Content="重置筛选条件"
                                       Icon="{ui:SymbolIcon Broom24}"
                                       Appearance="Secondary"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"
                                       Command="{Binding ResetProxyFiltersCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Row 6: Proxy Cards List -->
                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <ItemsControl ItemsSource="{Binding FilteredProxies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14,12">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource InteractiveCardStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Selection CheckBox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0"
                                                      ToolTip="选中节点以进行批量导出、测速或管理" />

                                            <!-- Protocol Icon Badge -->
                                            <Border Grid.Column="1"
                                                    Width="42"
                                                    Height="42"
                                                    CornerRadius="10"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticPurpleBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticPurpleBorderBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProtocolDisplay}" Value="HTTP">
                                                                <Setter Property="Background" Value="{DynamicResource SemanticInfoBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticInfoBorderBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ProtocolDisplay}" Value="HTTPS">
                                                                <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ProtocolDisplay}" Value="VLESS">
                                                                <Setter Property="Background" Value="{DynamicResource SemanticTealBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticTealBorderBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ui:SymbolIcon FontSize="19">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="Globe24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticPurpleBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProtocolDisplay}" Value="HTTP">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticInfoBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProtocolDisplay}" Value="HTTPS">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                    <Setter Property="Symbol" Value="ShieldCheckmark24" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProtocolDisplay}" Value="VLESS">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticTealBrush}" />
                                                                    <Setter Property="Symbol" Value="ShieldCheckmark24" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                            </Border>

                                            <!-- Node Info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="280"
                                                               VerticalAlignment="Center" />

                                                    <!-- Protocol Pill -->
                                                    <Border Margin="8,0,0,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Background" Value="{DynamicResource SemanticPurpleBgBrush}" />
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticPurpleBorderBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProtocolDisplay}" Value="HTTP">
                                                                        <Setter Property="Background" Value="{DynamicResource SemanticInfoBgBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticInfoBorderBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ProtocolDisplay}" Value="HTTPS">
                                                                        <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ProtocolDisplay}" Value="VLESS">
                                                                        <Setter Property="Background" Value="{DynamicResource SemanticTealBgBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticTealBorderBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ProtocolDisplay}" FontSize="10.5" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticPurpleBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ProtocolDisplay}" Value="HTTP">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticInfoBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProtocolDisplay}" Value="HTTPS">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProtocolDisplay}" Value="VLESS">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticTealBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <!-- Security Pill (REALITY / TLS for VLESS) -->
                                                    <Border Margin="6,0,0,0"
                                                            Background="{DynamicResource SemanticPurpleBgBrush}"
                                                            BorderBrush="{DynamicResource SemanticPurpleBorderBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasSecurityBadge}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding SecurityBadgeText}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SemanticPurpleBrush}" />
                                                    </Border>

                                                    <!-- Auth Pill -->
                                                    <Border Margin="6,0,0,0"
                                                            Background="{DynamicResource SemanticWarningBgBrush}"
                                                            BorderBrush="{DynamicResource SemanticWarningBorderBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAuth}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="认证"
                                                                   FontSize="10.5"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource SemanticWarningBrush}" />
                                                    </Border>

                                                    <!-- Missing Xray-core Warning Pill -->
                                                    <Border Margin="6,0,0,0"
                                                            Background="{DynamicResource SemanticWarningBgBrush}"
                                                            BorderBrush="{DynamicResource SemanticWarningBorderBrush}"
                                                            ToolTip="当前未就绪 Xray-core 内核，请前往系统设置配置 xray.exe">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding RequiresXrayCore}" Value="True" />
                                                                            <Condition Binding="{Binding DataContext.IsXrayCoreAvailable, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="缺少 Xray"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SemanticWarningBrush}" />
                                                    </Border>
                                                </WrapPanel>

                                                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border Style="{StaticResource CompactPillBadgeStyle}"
                                                            Margin="0,0,6,2"
                                                            Padding="7,2">
                                                        <TextBlock Text="{Binding EndpointDisplay}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>

                                                    <!-- VLESS Transport / SNI Summary Pill -->
                                                    <Border Margin="0,0,6,2"
                                                            Padding="7,2"
                                                            ToolTip="{Binding VlessSummaryText}">
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasVlessSummary}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding VlessSummaryText}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   MaxWidth="220"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>

                                                    <!-- Exit IP & Region Pill -->
                                                    <Button Padding="0"
                                                            Margin="0,0,6,2"
                                                            BorderThickness="0"
                                                            Background="Transparent"
                                                            VerticalAlignment="Center"
                                                            ToolTip="{Binding ExitTooltipText}"
                                                            Click="OnCopyProxyExitIpClick">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Setter Property="Cursor" Value="Arrow" />
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="PillHost" Background="Transparent">
                                                                                <ContentPresenter />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="PillHost" Property="Opacity" Value="0.86" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsPressed" Value="True">
                                                                                    <Setter TargetName="PillHost" Property="Opacity" Value="0.7" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasExitInfo}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ExitBadgeState}" Value="Ok">
                                                                        <Setter Property="Cursor" Value="Hand" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ExitBadgeState}" Value="Copied">
                                                                        <Setter Property="Cursor" Value="Hand" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Border Padding="7,2" CornerRadius="5" BorderThickness="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource SemanticTealBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticTealBorderBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ExitBadgeState}" Value="Copied">
                                                                            <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ExitBadgeState}" Value="Detecting">
                                                                            <Setter Property="Background" Value="{DynamicResource SemanticInfoBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticInfoBorderBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ExitBadgeState}" Value="Error">
                                                                            <Setter Property="Background" Value="{DynamicResource SemanticErrorBgBrush}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticErrorBorderBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ExitBadgeText}" FontSize="11" FontWeight="Medium">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticTealBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ExitBadgeState}" Value="Copied">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ExitBadgeState}" Value="Detecting">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticInfoBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ExitBadgeState}" Value="Error">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ui:SymbolIcon Symbol="Copy24"
                                                                               FontSize="11"
                                                                               Margin="5,0,0,0"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource SemanticTealBrush}">
                                                                    <ui:SymbolIcon.Style>
                                                                        <Style TargetType="ui:SymbolIcon">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ExitBadgeState}" Value="Ok">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ui:SymbolIcon.Style>
                                                                </ui:SymbolIcon>
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Color-Graded Latency Pill + Actions -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Border MinWidth="76"
                                                        Padding="9,4"
                                                        CornerRadius="12"
                                                        BorderThickness="1"
                                                        Margin="0,0,8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticNeutralBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LatencyLevel}" Value="Good">
                                                                    <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LatencyLevel}" Value="Medium">
                                                                    <Setter Property="Background" Value="{DynamicResource SemanticWarningBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticWarningBorderBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LatencyLevel}" Value="Bad">
                                                                    <Setter Property="Background" Value="{DynamicResource SemanticErrorBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticErrorBorderBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LatencyLevel}" Value="Testing">
                                                                    <Setter Property="Background" Value="{DynamicResource SemanticInfoBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticInfoBorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding LatencyLevel}" Value="Good">
                                                                            <Setter Property="Fill" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding LatencyLevel}" Value="Medium">
                                                                            <Setter Property="Fill" Value="{DynamicResource SemanticWarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding LatencyLevel}" Value="Bad">
                                                                            <Setter Property="Fill" Value="{DynamicResource SemanticErrorBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding LatencyLevel}" Value="Testing">
                                                                            <Setter Property="Fill" Value="{DynamicResource SemanticInfoBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding LatencyDisplay}" FontSize="12" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding LatencyLevel}" Value="Good">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding LatencyLevel}" Value="Medium">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding LatencyLevel}" Value="Bad">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding LatencyLevel}" Value="Testing">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticInfoBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <ui:Button Content="测速"
                                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                                           Appearance="Secondary"
                                                           Padding="9,6"
                                                           Command="{Binding DataContext.TestProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                                <Border Style="{StaticResource ToolbarVerticalDividerStyle}" />
                                                <ui:Button Icon="{ui:SymbolIcon Globe24}"
                                                           Appearance="Secondary"
                                                           Padding="8,6"
                                                           Margin="0,0,4,0"
                                                           ToolTip="检测落地出口 IP 与归属地"
                                                           Command="{Binding DataContext.DetectProxyExitIpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Icon="{ui:SymbolIcon Link24}"
                                                           Appearance="Secondary"
                                                           Padding="8,6"
                                                           Margin="0,0,4,0"
                                                           ToolTip="复制节点链接 (URI)"
                                                           Command="{Binding DataContext.CopySingleProxyUriCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Icon="{ui:SymbolIcon DocumentCopy24}"
                                                           Appearance="Secondary"
                                                           Padding="8,6"
                                                           Margin="0,0,4,0"
                                                           ToolTip="克隆代理节点"
                                                           Click="OnCloneProxyClick" />
                                                <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                                           Appearance="Secondary"
                                                           Padding="8,6"
                                                           Margin="0,0,4,0"
                                                           ToolTip="编辑代理节点"
                                                           Click="OnEditProxyClick" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                           Appearance="Secondary"
                                                           Padding="8,6"
                                                           ToolTip="删除代理节点"
                                                           Command="{Binding DataContext.DeleteProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 2: Live Monitor -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="实时监控" Style="{StaticResource PageTitleTextStyle}" VerticalAlignment="Center" />
                                <Border Margin="10,0,0,0" Padding="8,2.5" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticNeutralBorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6.5" Height="6.5" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource SemanticSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="待命 · 等待启动应用" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                                            <Setter Property="Text" Value="{Binding ActiveBridgesCount, StringFormat='监控中 · {0} 个活跃桥接'}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="查看注入应用发起的实时网络连接、流量统计与进程注入/Fake-IP 解析事件"
                                       Style="{StaticResource PageSubtitleTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: 4-Card Telemetry KPI Strip -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- KPI 1: Active Bridges -->
                        <Border Grid.Column="0" CornerRadius="10" Padding="13,10" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SemanticTealBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticTealBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="活跃桥接实例" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveBridgesCount}" FontSize="19" FontWeight="Bold" Margin="0,2,0,1" />
                                    <TextBlock Text="独立后台桥接进程" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SemanticTealBorderBrush}"
                                        Background="{DynamicResource SemanticTealBgBrush}">
                                    <ui:SymbolIcon Symbol="PlugConnected24" FontSize="16" Foreground="{DynamicResource SemanticTealBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- KPI 2: Active Connections -->
                        <Border Grid.Column="2" CornerRadius="10" Padding="13,10" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveBridges}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="当前活跃连接" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding ActiveConnectionsCount}" FontSize="19" FontWeight="Bold" Margin="0,2,0,1" />
                                    <TextBlock Text="{Binding Connections.Count, StringFormat='累计记录 {0} 条'}" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SemanticSuccessBorderBrush}"
                                        Background="{DynamicResource SemanticSuccessBgBrush}">
                                    <ui:SymbolIcon Symbol="Pulse24" FontSize="16" Foreground="{DynamicResource SemanticSuccessBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- KPI 3: Total Upload -->
                        <Border Grid.Column="4" Style="{StaticResource SectionCardStyle}" Padding="13,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="累计上传流量" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalBytesUpFormatted}" FontSize="19" FontWeight="Bold" Margin="0,2,0,1" />
                                    <TextBlock Text="全部会话上行字节" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SemanticInfoBorderBrush}"
                                        Background="{DynamicResource SemanticInfoBgBrush}">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="16" Foreground="{DynamicResource SemanticInfoBrush}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- KPI 4: Total Download -->
                        <Border Grid.Column="6" Style="{StaticResource SectionCardStyle}" Padding="13,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="累计下载流量" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalBytesDownFormatted}" FontSize="19" FontWeight="Bold" Margin="0,2,0,1" />
                                    <TextBlock Text="全部会话下行字节" FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Width="34"
                                        Height="34"
                                        CornerRadius="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SemanticPurpleBorderBrush}"
                                        Background="{DynamicResource SemanticPurpleBgBrush}">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" Foreground="{DynamicResource SemanticPurpleBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: Unified Filter & Clear Toolbar -->
                    <Border Grid.Row="2" Style="{StaticResource ToolbarStripStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="185" MaxWidth="310" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding ConnectionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="过滤进程、目标域名、节点、状态或事件..."
                                            Icon="{ui:SymbolIcon Search24}"
                                            VerticalAlignment="Center" />

                                <ComboBox Grid.Column="1"
                                          Width="138"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding ConnectionStatusFilter, Mode=TwoWay}"
                                          ToolTip="按连接状态筛选">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMonitorTabIndex}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                    <ComboBoxItem Content="全部状态" Tag="All" />
                                    <ComboBoxItem Content="活跃 (Active)" Tag="Active" />
                                    <ComboBoxItem Content="连接中" Tag="Connecting" />
                                    <ComboBoxItem Content="已关闭" Tag="Closed" />
                                    <ComboBoxItem Content="异常 (Error)" Tag="Error" />
                                </ComboBox>

                                <ComboBox Grid.Column="2"
                                          Width="142"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding EventCategoryFilter, Mode=TwoWay}"
                                          ToolTip="按事件类别筛选">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedMonitorTabIndex}" Value="1">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                    <ComboBoxItem Content="全部事件" Tag="All" />
                                    <ComboBoxItem Content="启动与注入" Tag="Injection" />
                                    <ComboBoxItem Content="连接与网络" Tag="Network" />
                                    <ComboBoxItem Content="DNS / Fake-IP" Tag="Dns" />
                                    <ComboBoxItem Content="告警与错误" Tag="Issue" />
                                </ComboBox>

                                <ui:Button Grid.Column="3"
                                           Content="重置"
                                           Icon="{ui:SymbolIcon Broom24}"
                                           Appearance="Secondary"
                                           Margin="8,0,0,0"
                                           Padding="10,6"
                                           Command="{Binding ResetMonitorFiltersCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasActiveMonitorFilter}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <ui:Button Content="清空连接"
                                           Icon="{ui:SymbolIcon Broom24}"
                                           Appearance="Secondary"
                                           Margin="0,0,6,0"
                                           Command="{Binding ClearConnectionsCommand}" />
                                <ui:Button Content="清空事件"
                                           Icon="{ui:SymbolIcon Delete24}"
                                           Appearance="Secondary"
                                           Command="{Binding ClearProcessEventsCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 3: Telemetry DataGrids -->
                    <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedMonitorTabIndex}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="实时网络连接" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource CompactPillBadgeStyle}" Margin="7,0,0,0">
                                        <TextBlock Text="{Binding Connections.Count}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
