                                                       FontSize="11.5"
                                                       FontFamily="Consolas"
                                                       Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <ui:InfoBar Title="独立桥接与进程生命周期说明"
                                        IsOpen="True"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Message="AppProxy 为每个启动的应用分配独立后台桥接进程（AppProxy.Bridge.exe），挂起目标主线程并在 OEP 注入 x86/x64 Hook DLL，拦截 Winsock、Fake-IP DNS 与子进程继承；关闭 UI 窗口不影响已启动的代理应用，目标应用进程树全部退出后对应后台桥接进程自动释放。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Padding="16,7"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
