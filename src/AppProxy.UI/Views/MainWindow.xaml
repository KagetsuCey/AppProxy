                                                        <DataTrigger Binding="{Binding IsDownloadingXray}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Content="取消下载"
                                                   Appearance="Secondary"
                                                   Margin="0,0,8,4"
                                                   Command="{Binding CancelDownloadXrayCoreCommand}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDownloadingXray}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <ui:Button Content="检测状态"
                                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                                   Appearance="Secondary"
                                                   Margin="0,0,8,4"
                                                   Command="{Binding RefreshXrayCoreStatusCommand}" />
                                        <ui:Button Content="打开内核目录"
                                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                                   Appearance="Secondary"
                                                   Margin="0,0,0,4"
                                                   Command="{Binding OpenXrayCoreDirectoryCommand}" />
                                    </WrapPanel>

                                    <StackPanel Margin="52,8,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownloadingXray}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ProgressBar Height="6"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding XrayDownloadProgressPercent, Mode=OneWay}" />
                                        <TextBlock Text="{Binding XrayDownloadStatusText}"
                                                   FontSize="11.5"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- High-Contrast Xray-core Status Callout -->
                                    <Border Margin="52,10,0,0" CornerRadius="8" Padding="12,10" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SemanticInfoBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource SemanticInfoBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticErrorBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticErrorBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource SemanticInfoBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                                    <Setter Property="Fill" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                                    <Setter Property="Fill" Value="{DynamicResource SemanticErrorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding XrayCoreHeadline}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SemanticInfoBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding XrayCoreDetailText}"
                                                       FontSize="11.5"
                                                       FontFamily="Consolas"
                                                       Margin="16,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Portable Config Card -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                CornerRadius="9"
                                                Margin="0,0,14,0"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource SemanticTealBorderBrush}"
                                                Background="{DynamicResource SemanticTealBgBrush}">
                                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="19" Foreground="{DynamicResource SemanticTealBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="应用数据与配置文件位置" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="配置 (config.json)、浏览器隔离 (profiles\)、日志 (logs\) 与托管内核 (cores\) 均保存在程序相对目录 data\ 下"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Content="打开数据目录"
                                                       Icon="{ui:SymbolIcon FolderOpen24}"
                                                       Appearance="Secondary"
                                                       Margin="0,0,8,0"
                                                       Command="{Binding OpenDataDirectoryCommand}" />
                                            <ui:Button Content="复制路径"
                                                       Icon="{ui:SymbolIcon Copy24}"
                                                       Appearance="Secondary"
                                                       Command="{Binding CopyConfigFilePathCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Margin="52,12,0,0"
                                            CornerRadius="8"
                                            Padding="12,9"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource SubtleDividerBrush}"
                                            Background="{DynamicResource InputSurfaceBgBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ConfigFilePath}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Consolas"
                                                       TextWrapping="Wrap" />
