<ui:FluentWindow x:Class="AppProxy.UI.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AppProxy - 应用级代理注入启动器"
                 Width="1160"
                 Height="740"
                 MinWidth="920"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="AppProxy">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Shield24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Shell -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Rail -->
            <Border Grid.Column="0"
                    Padding="10,12,10,12"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <DockPanel>
                    <ListBox DockPanel.Dock="Top"
                             SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="Margin" Value="0,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Apps24" Margin="0,0,10,0" />
                                <TextBlock Text="应用管理" VerticalAlignment="Center" FontWeight="Medium" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Globe24" Margin="0,0,10,0" />
                                <TextBlock Text="代理节点" VerticalAlignment="Center" FontWeight="Medium" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Pulse24" Margin="0,0,10,0" />
                                <TextBlock Text="实时监控" VerticalAlignment="Center" FontWeight="Medium" />
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" />
                                <TextBlock Text="系统设置" VerticalAlignment="Center" FontWeight="Medium" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <Border DockPanel.Dock="Bottom"
                            VerticalAlignment="Bottom"
                            CornerRadius="8"
                            Padding="10"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="引擎状态" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding BridgeStatusText}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="活跃连接: " />
                                <Run Text="{Binding ActiveConnectionsCount, Mode=OneWay}" FontWeight="Bold" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Page Host -->
            <Grid Grid.Column="1" Margin="18,12,18,12">

                <!-- PAGE 0: Applications -->
                <Grid AllowDrop="True" DragOver="OnAppsDragOver" Drop="OnAppsDrop">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="应用管理" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="配置目标应用与代理绑定，点击启动将自动通过 DLL 注入接管网络与 DNS（支持拖拽 .exe 或快捷方式 .lnk 添加）"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding AppSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="搜索应用名称或路径..."
                                    Icon="{ui:SymbolIcon Search24}"
                                    Margin="12,0"
                                    VerticalAlignment="Center" />
                        <ui:Button Grid.Column="2"
                                   Content="添加应用"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Appearance="Primary"
                                   Click="OnAddAppClick"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Empty Hint -->
                    <Border Grid.Row="1"
                            Margin="0,0,0,12"
                            CornerRadius="8"
                            Padding="14"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Apps.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Apps24" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="当前还没有配置任何应用。点击右上角「添加应用」，或直接把 .exe / 应用快捷方式 (.lnk) 拖放到此处即可快速创建。"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- App Cards List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,10"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- App Icon -->
                                            <Border Grid.Column="0"
                                                    Width="44"
                                                    Height="44"
                                                    CornerRadius="8"
                                                    Margin="0,0,14,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <ui:SymbolIcon Symbol="Apps24" FontSize="22">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Grid>
                                            </Border>

                                            <!-- Metadata -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                        <TextBlock Text="{Binding DetectedArch}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <TextBlock Text="{Binding BoundProxyName}" FontSize="11" />
                                                    </Border>
                                                    <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RemoteDns}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="Fake-IP DNS" FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ExePath}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Quick Proxy Switch + Actions -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <ComboBox Width="170"
                                                          Margin="0,0,8,0"
                                                          ItemsSource="{Binding DataContext.Proxies, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding ProxyProfileId, Mode=TwoWay}"
                                                          SelectionChanged="OnQuickProxyChanged"
                                                          ToolTip="快速切换绑定代理" />
                                                <ui:Button Content="启动代理"
                                                           Icon="{ui:SymbolIcon Play24}"
                                                           Appearance="Primary"
                                                           Margin="0,0,6,0"
                                                           Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Content="创建快捷方式"
                                                           Icon="{ui:SymbolIcon Desktop24}"
                                                           Appearance="Secondary"
                                                           Margin="0,0,6,0"
                                                           ToolTip="在桌面创建快捷方式，双击即可不打开 UI 直接启动代理"
                                                           Command="{Binding DataContext.CreateDesktopShortcutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                                           Appearance="Secondary"
                                                           Margin="0,0,6,0"
                                                           ToolTip="编辑配置"
                                                           Click="OnEditAppClick" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                           Appearance="Secondary"
                                                           ToolTip="删除"
                                                           Command="{Binding DataContext.DeleteAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 1: Proxies -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="代理节点" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="管理 SOCKS5 / HTTP / HTTPS 上游代理服务器并测试连通性与握手延迟"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:Button Content="全部测速"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Appearance="Secondary"
                                       Margin="0,0,8,0"
                                       Command="{Binding TestAllProxiesCommand}" />
                            <ui:Button Content="添加代理"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Appearance="Primary"
                                       Click="OnAddProxyClick" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Proxies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8"
                                            Padding="14"
                                            Margin="0,0,0,10"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="42"
                                                    Height="42"
                                                    CornerRadius="8"
                                                    Margin="0,0,14,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <ui:SymbolIcon Symbol="Server24" FontSize="20" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                        <TextBlock Text="{Binding ProtocolDisplay}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAuth}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="认证" FontSize="11" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding EndpointDisplay}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Padding="10,4"
                                                        CornerRadius="12"
                                                        Margin="0,0,10,0"
                                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                    <TextBlock Text="{Binding LatencyDisplay}" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <ui:Button Content="测速"
                                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                                           Appearance="Secondary"
                                                           Margin="0,0,6,0"
                                                           Command="{Binding DataContext.TestProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                                           Appearance="Secondary"
                                                           Margin="0,0,6,0"
                                                           Click="OnEditProxyClick" />
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}"
                                                           Appearance="Secondary"
                                                           Command="{Binding DataContext.DeleteProxyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- PAGE 2: Live Monitor -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="实时监控" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="查看注入应用发起的实时网络连接、流量统计与进程注入/Fake-IP 解析事件"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1"
                                    Text="{Binding ConnectionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="过滤进程/域名/状态..."
                                    Icon="{ui:SymbolIcon Search24}"
                                    Margin="12,0"
                                    VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Content="清空连接"
                                       Icon="{ui:SymbolIcon Broom24}"
                                       Appearance="Secondary"
                                       Margin="0,0,6,0"
                                       Command="{Binding ClearConnectionsCommand}" />
                            <ui:Button Content="清空事件"
                                       Appearance="Secondary"
                                       Command="{Binding ClearProcessEventsCommand}" />
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedMonitorTabIndex}">
                        <TabItem Header="实时网络连接">
                            <DataGrid ItemsSource="{Binding FilteredConnections}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding FormattedTime}" Width="95" />
                                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="130" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" />
                                    <DataGridTextColumn Header="目标地址" Binding="{Binding TargetDisplay}" Width="220" />
                                    <DataGridTextColumn Header="Fake-IP" Binding="{Binding FakeIp}" Width="115" />
                                    <DataGridTextColumn Header="代理节点" Binding="{Binding ProxyName}" Width="130" />
                                    <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="75" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90" />
                                    <DataGridTextColumn Header="延迟(ms)" Binding="{Binding LatencyMs}" Width="75" />
                                    <DataGridTextColumn Header="↑ 上传" Binding="{Binding FormattedUp}" Width="85" />
                                    <DataGridTextColumn Header="↓ 下载" Binding="{Binding FormattedDown}" Width="85" />
                                    <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="注入与 DNS 事件">
                            <DataGrid ItemsSource="{Binding ProcessEvents}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Margin="0,8,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Binding="{Binding FormattedTime}" Width="95" />
                                    <DataGridTextColumn Header="会话" Binding="{Binding SessionId}" Width="60" />
                                    <DataGridTextColumn Header="事件" Binding="{Binding EventType}" Width="110" />
                                    <DataGridTextColumn Header="架构" Binding="{Binding Arch}" Width="60" />
                                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                    <DataGridTextColumn Header="父PID" Binding="{Binding ParentPid}" Width="70" />
                                    <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- PAGE 3: Settings -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedNavIndex}" Value="3">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="系统设置" FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />

                        <Border CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="深色外观主题" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="切换 Fluent 深色 / 浅色界面主题"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ui:ToggleSwitch IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="代理测速目标" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Grid.Column="0" Text="{Binding TestProbeHost, UpdateSourceTrigger=LostFocus}" PlaceholderText="www.gstatic.com" />
                                    <ui:TextBox Grid.Column="2" Text="{Binding TestProbePort, UpdateSourceTrigger=LostFocus}" PlaceholderText="80" />
                                    <ui:Button Grid.Column="4" Content="保存" Appearance="Primary" Command="{Binding SaveConfigurationCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="配置文件位置" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="所有代理节点、应用配置与界面设置均保存在程序同级目录的 config.json 中"
                                           FontSize="12"
                                           Margin="0,2,0,6"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ConfigFilePath}"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <ui:InfoBar Title="工作原理说明"
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Message="AppProxy 为每个启动的应用分配独立后台桥接进程（AppProxy.Bridge.exe），挂起目标主线程并在 OEP 注入 x86/x64 Hook DLL，拦截 Winsock、Fake-IP DNS 与子进程继承；关闭 UI 窗口不影响已启动的代理应用，目标应用进程树全部退出后对应后台桥接进程自动释放。" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2"
                Padding="14,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BridgeStatusText}"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
