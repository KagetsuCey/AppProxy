                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                CornerRadius="9"
                                                Margin="0,0,14,0"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource SemanticSuccessBorderBrush}"
                                                Background="{DynamicResource SemanticSuccessBgBrush}">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="19" Foreground="{DynamicResource SemanticSuccessBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="全局 TUN 网卡隔离 (防双重代理)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                            <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticNeutralBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding BypassGlobalTun}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="已关闭" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding BypassGlobalTun}" Value="True">
                                                                        <Setter Property="Text" Value="已开启" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Border Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SemanticWarningBgBrush}"
                                                        BorderBrush="{DynamicResource SemanticWarningBorderBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource CompactPillBadgeStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActiveTun}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="检测到活跃 TUN" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SemanticWarningBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="连接上游代理与节点测速时自动绕过 v2rayN / Clash 等全局 TUN 虚拟网卡，并在网线拔插或切换 Wi-Fi 时自动故障转移"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="2"
                                                         IsChecked="{Binding BypassGlobalTun, Mode=TwoWay}"
                                                         VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="52,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding OutboundInterfaceChoices}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding PreferredOutboundInterface, Mode=TwoWay}"
                                                  IsEnabled="{Binding BypassGlobalTun}" />
                                        <ui:Button Grid.Column="2"
                                                   Content="刷新网卡"
                                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                                   Appearance="Secondary"
                                                   Command="{Binding RefreshOutboundInterfacesCommand}" />
                                    </Grid>

                                    <Border Margin="52,10,0,0" CornerRadius="8" Padding="12,9" BorderThickness="1">
