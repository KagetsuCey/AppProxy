                                                    <DataTrigger Binding="{Binding OutboundStatusLevel}" Value="Ok">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding OutboundStatusLevel}" Value="Warning">
                                                        <Setter Property="Background" Value="{DynamicResource SemanticWarningBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SemanticWarningBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OutboundStatusLevel}" Value="Ok">
                                                                    <Setter Property="Fill" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OutboundStatusLevel}" Value="Warning">
                                                                    <Setter Property="Fill" Value="{DynamicResource SemanticWarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding OutboundHeadline}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding OutboundStatusLevel}" Value="Ok">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding OutboundStatusLevel}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding OutboundTunBadgeText}"
                                                       FontSize="11.5"
                                                       Margin="16,3,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Xray-core Managed Sidecar Card -->
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                CornerRadius="9"
                                                Margin="0,0,14,0"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource SemanticPurpleBorderBrush}"
                                                Background="{DynamicResource SemanticPurpleBgBrush}">
                                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="19" Foreground="{DynamicResource SemanticPurpleBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Xray-core 托管内核 (可选 · 支持 VLESS / REALITY)" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Margin="8,0,0,0" Padding="8,2.5" CornerRadius="5" BorderThickness="1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource SemanticNeutralBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SemanticNeutralBorderBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                                    <Setter Property="Background" Value="{DynamicResource SemanticSuccessBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticSuccessBorderBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                                    <Setter Property="Background" Value="{DynamicResource SemanticErrorBgBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource SemanticErrorBorderBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding XrayCoreBadgeText}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding XrayCoreState}" Value="Ready">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding XrayCoreState}" Value="Error">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="未配置时仅开放原生 SOCKS5 / HTTP / HTTPS；配置或一键下载 xray.exe 后可解锁 VLESS + REALITY / TLS 节点并继承全局 TUN 绕过"
                                                       FontSize="12"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="52,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Grid.Column="0"
                                                    Text="{Binding XrayCorePath, UpdateSourceTrigger=LostFocus}"
                                                    PlaceholderText="留空自动探测 data\cores\xray.exe，或点击右侧浏览指定路径" />
                                        <ui:Button Grid.Column="2"
                                                   Content="浏览..."
                                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                                   Appearance="Secondary"
                                                   Click="OnBrowseXrayCoreClick" />
                                        <ui:Button Grid.Column="4"
                                                   Content="清除"
                                                   Appearance="Secondary"
                                                   Command="{Binding ClearXrayCorePathCommand}" />
                                    </Grid>

                                    <WrapPanel Margin="52,10,0,0" Orientation="Horizontal">
                                        <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}"
                                                   Margin="0,0,8,4"
                                                   Command="{Binding DownloadXrayCoreCommand}">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Content" Value="一键下载 Xray-core" />
                                                    <Setter Property="Appearance" Value="Primary" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsXrayCoreAvailable}" Value="True">
                                                            <Setter Property="Content" Value="更新 Xray-core" />
                                                            <Setter Property="Appearance" Value="Secondary" />
