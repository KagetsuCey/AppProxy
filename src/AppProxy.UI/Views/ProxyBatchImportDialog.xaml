<ui:FluentWindow x:Class="AppProxy.UI.Views.ProxyBatchImportDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="批量导入代理节点"
                 Width="700"
                 Height="700"
                 MinWidth="600"
                 MinHeight="580"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="pack://application:,,,/Assets/AppProxy.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="批量导入代理节点" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,12,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="168" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Format Hint Banner -->
            <Border Grid.Row="0"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,0,0,12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemanticInfoBorderBrush}"
                    Background="{DynamicResource SemanticInfoBgBrush}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="17" Foreground="{DynamicResource SemanticInfoBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="支持多格式每行一条或整段 JSON 导入" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="FormatHintTextBlock"
                                   Text="socks5://user:pass@host:port#备注 · http(s)://host:port · host:port:user:pass · user:pass@host:port · host:port · AppProxy JSON"
                                   FontSize="11.5"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Input Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource ToolbarStripStyle}" Padding="10,7" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="从剪贴板粘贴"
                               Icon="{ui:SymbolIcon Copy24}"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               Click="OnPasteClipboardClick" />
                    <ui:Button Content="从文件打开"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               Click="OnOpenFileClick" />
                    <ui:Button Content="清空"
                               Icon="{ui:SymbolIcon Broom24}"
                               Appearance="Secondary"
                               Click="OnClearClick" />
                </StackPanel>
            </Border>

            <!-- Raw Text Input Container -->
            <Border Grid.Row="2"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource InputSurfaceBgBrush}">
                <Grid>
                    <TextBox x:Name="InputTextBox"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="11,9"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="OnInputOrOptionChanged" />
                    <TextBlock Text="在此粘贴代理 URI、host:port:user:pass 列表或 JSON 配置..."
                               Margin="13,10,13,10"
                               FontFamily="Consolas"
                               FontSize="12"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Parse Options -->
            <Grid Grid.Row="3" Margin="0,10,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="纯文本默认协议:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                    <ComboBox x:Name="DefaultProtocolCombo"
                              Width="156"
                              SelectionChanged="OnProtocolSelectionChanged">
                        <ComboBoxItem Content="SOCKS5" Tag="Socks5" IsSelected="True" />
                        <ComboBoxItem Content="HTTP (CONNECT)" Tag="Http" />
                        <ComboBoxItem Content="HTTPS (TLS)" Tag="Https" />
                    </ComboBox>
                </StackPanel>

                <CheckBox x:Name="SkipDuplicatesCheckBox"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          IsChecked="True"
                          Content="跳过已存在的重复节点"
                          Checked="OnInputOrOptionChanged"
                          Unchecked="OnInputOrOptionChanged" />
            </Grid>

            <!-- Parse Summary + Errors -->
            <StackPanel Grid.Row="4" Margin="0,0,0,8">
                <TextBlock x:Name="SummaryTextBlock"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Text="请在上方粘贴或打开代理节点列表" />
                <Border x:Name="ErrorBoxBorder"
                        Visibility="Collapsed"
                        Margin="0,6,0,0"
                        Padding="10,8"
                        CornerRadius="8"
                        MaxHeight="88"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemanticErrorBorderBrush}"
                        Background="{DynamicResource SemanticErrorBgBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ErrorDetailsTextBlock"
                                   FontFamily="Consolas"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SemanticErrorBrush}" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Preview List with Header Strip -->
            <Border Grid.Row="5"
                    CornerRadius="9"
                    ClipToBounds="True"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="12,7"
                            Background="{DynamicResource DataGridHeaderBgBrush}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource SubtleDividerBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="协议" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="节点名称" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="服务器地址" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="状态" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <ListView x:Name="PreviewListView"
                              Grid.Row="1"
                              Background="Transparent"
                              BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding ProtocolText}"
                                               FontWeight="SemiBold"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource SemanticInfoBrush}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding EndpointText}"
                                               FontFamily="Consolas"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding StatusText}"
                                               FontSize="11.5"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding StatusBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="20,12,20,14"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消" Appearance="Secondary" Click="OnCancelClick" Margin="0,0,10,0" Width="92" />
                <ui:Button x:Name="ImportButton"
                           Content="导入 (0)"
                           Appearance="Primary"
                           IsEnabled="False"
                           Click="OnImportClick"
                           MinWidth="112" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
