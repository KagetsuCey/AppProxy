<ui:FluentWindow x:Class="AppProxy.UI.Views.ProxyEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="配置代理节点"
                 Width="480"
                 Height="535"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="pack://application:,,,/Assets/AppProxy.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="代理服务器配置" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Padding="20,10,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Header Banner -->
                <Border CornerRadius="10"
                        Padding="14,12"
                        Margin="0,0,0,14"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SemanticInfoBorderBrush}"
                        Background="{DynamicResource SemanticInfoBgBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36"
                                Height="36"
                                CornerRadius="8"
                                Margin="0,0,12,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="18" Foreground="{DynamicResource SemanticInfoBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="上游代理节点参数" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="支持 SOCKS5、HTTP CONNECT 与 HTTPS TLS 隧道转发"
                                       FontSize="11.5"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section 1: Identity & Protocol -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="节点名称" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="NameBox" PlaceholderText="例如: HK SOCKS5" Margin="0,0,0,12" />

                        <TextBlock Text="代理协议" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="ProtocolCombo">
                            <ComboBoxItem Content="SOCKS5" Tag="Socks5" />
                            <ComboBoxItem Content="HTTP (CONNECT)" Tag="Http" />
                            <ComboBoxItem Content="HTTPS (TLS CONNECT)" Tag="Https" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Section 2: Endpoint & Auth -->
                <Border Style="{StaticResource SectionCardStyle}" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="服务器地址 (Host / IP)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="HostBox" PlaceholderText="127.0.0.1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="端口 (Port)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="PortBox" PlaceholderText="1080" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Margin="0,0,0,12" Background="{DynamicResource SubtleDividerBrush}" />

                        <TextBlock Text="身份认证（无认证可留空）"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="用户名" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:TextBox x:Name="UsernameBox" PlaceholderText="可选" Margin="0,0,0,10" />

                        <TextBlock Text="密码" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="可选" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Action Bar -->
        <Border Grid.Row="2"
                Padding="20,12,20,14"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消" Appearance="Secondary" Click="OnCancel" Margin="0,0,10,0" Width="92" />
                <ui:Button Content="保存节点" Appearance="Primary" Click="OnSave" Width="104" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
