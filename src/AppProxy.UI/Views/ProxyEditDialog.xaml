<ui:FluentWindow x:Class="AppProxy.UI.Views.ProxyEditDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="配置代理节点"
                 Width="460"
                 Height="480"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="代理服务器配置" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="20,12,20,12">
            <TextBlock Text="节点名称" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:TextBox x:Name="NameBox" PlaceholderText="例如: HK SOCKS5" Margin="0,0,0,12" />

            <TextBlock Text="代理协议" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="ProtocolCombo" Margin="0,0,0,12">
                <ComboBoxItem Content="SOCKS5" Tag="Socks5" />
                <ComboBoxItem Content="HTTP (CONNECT)" Tag="Http" />
                <ComboBoxItem Content="HTTPS (TLS CONNECT)" Tag="Https" />
            </ComboBox>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="服务器地址 (Host / IP)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="HostBox" PlaceholderText="127.0.0.1" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="端口 (Port)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="PortBox" PlaceholderText="1080" />
                </StackPanel>
            </Grid>

            <TextBlock Text="用户名 (可选)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:TextBox x:Name="UsernameBox" PlaceholderText="无认证可留空" Margin="0,0,0,12" />

            <TextBlock Text="密码 (可选)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="无认证可留空" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16">
            <ui:Button Content="取消" Appearance="Secondary" Click="OnCancel" Margin="0,0,10,0" Width="90" />
            <ui:Button Content="保存" Appearance="Primary" Click="OnSave" Width="90" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
