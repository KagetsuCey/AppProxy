<ui:FluentWindow x:Class="AppProxy.UI.Views.ProxyBatchExportDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="导出代理节点"
                 Width="680"
                 Height="600"
                 MinWidth="560"
                 MinHeight="480"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 Icon="pack://application:,,,/Assets/AppProxy.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="导出代理节点" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="20,12,20,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Info Banner -->
            <Border Grid.Row="0"
                    CornerRadius="10"
                    Padding="14,11"
                    Margin="0,0,0,12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemanticInfoBorderBrush}"
                    Background="{DynamicResource SemanticInfoBgBrush}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="17" Foreground="{DynamicResource SemanticInfoBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="预览、复制到剪贴板或保存代理节点配置" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="支持标准代理 URI 列表（socks5:// / http:// / https://）与完整 AppProxy JSON 格式，可直接用于批量导入。"
                                   FontSize="11.5"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Format & Filter Strip -->
            <Border Grid.Row="1" Style="{StaticResource ToolbarStripStyle}" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="导出格式:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" />
                        <ComboBox x:Name="FormatCombo"
                                  Width="180"
                                  SelectionChanged="OnOptionChanged">
                            <ComboBoxItem Content="URI 列表 (每行一条)" Tag="Uri" IsSelected="True" />
                            <ComboBoxItem Content="JSON 配置" Tag="Json" />
                        </ComboBox>

                        <CheckBox x:Name="FilteredOnlyCheckBox"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Checked="OnOptionChanged"
                                  Unchecked="OnOptionChanged" />
                    </StackPanel>

                    <TextBlock x:Name="SummaryTextBlock"
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- Preview Output Box -->
            <Border Grid.Row="2"
                    CornerRadius="9"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource InputSurfaceBgBrush}">
                <TextBox x:Name="OutputTextBox"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="11,9"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </Border>

            <!-- Inline Feedback Banner -->
            <Border x:Name="FeedbackBorder"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Margin="0,10,0,0"
                    Padding="12,8"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SemanticSuccessBorderBrush}"
                    Background="{DynamicResource SemanticSuccessBgBrush}">
                <TextBlock x:Name="FeedbackTextBlock"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SemanticSuccessBrush}" />
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Padding="20,12,20,14"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <ui:Button Content="保存为文件"
                           Icon="{ui:SymbolIcon Save24}"
                           Appearance="Secondary"
                           HorizontalAlignment="Left"
                           Click="OnSaveFileClick" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="关闭"
                               Appearance="Secondary"
                               Click="OnCloseClick"
                               Margin="0,0,10,0"
                               Width="88" />
                    <ui:Button x:Name="CopyButton"
                               Content="复制到剪贴板"
                               Icon="{ui:SymbolIcon Copy24}"
                               Appearance="Primary"
                               Click="OnCopyClipboardClick"
                               MinWidth="138" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
