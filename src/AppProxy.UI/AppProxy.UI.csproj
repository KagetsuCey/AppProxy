<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationTitle>AppProxy</ApplicationTitle>
    <AssemblyName>AppProxy.UI</AssemblyName>
    <RootNamespace>AppProxy.UI</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="WPF-UI" Version="4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppProxy.Core\AppProxy.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyNativeBinaries" AfterTargets="Build">
    <PropertyGroup>
      <NativeOutDir>$(OutDir)native\</NativeOutDir>
      <NativeBinX64>$(MSBuildThisFileDirectory)..\..\artifacts\bin\x64\$(Configuration)\</NativeBinX64>
      <NativeBinX86>$(MSBuildThisFileDirectory)..\..\artifacts\bin\Win32\$(Configuration)\</NativeBinX86>
    </PropertyGroup>
    <MakeDir Directories="$(NativeOutDir)" />
    <ItemGroup>
      <NativeArtifacts Include="$(NativeBinX64)AppProxy.Hook.x64.dll" Condition="Exists('$(NativeBinX64)AppProxy.Hook.x64.dll')" />
      <NativeArtifacts Include="$(NativeBinX64)AppProxy.Injector.x64.exe" Condition="Exists('$(NativeBinX64)AppProxy.Injector.x64.exe')" />
      <NativeArtifacts Include="$(NativeBinX86)AppProxy.Hook.x86.dll" Condition="Exists('$(NativeBinX86)AppProxy.Hook.x86.dll')" />
      <NativeArtifacts Include="$(NativeBinX86)AppProxy.Injector.x86.exe" Condition="Exists('$(NativeBinX86)AppProxy.Injector.x86.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeArtifacts)" DestinationFolder="$(NativeOutDir)" SkipUnchangedFiles="true" Condition="'@(NativeArtifacts)' != ''" />
  </Target>

  <Target Name="BuildAndCopyBridgeBinaries" AfterTargets="Build">
    <PropertyGroup>
      <BridgeProject>$(MSBuildThisFileDirectory)..\AppProxy.Bridge\AppProxy.Bridge.csproj</BridgeProject>
      <BridgeBinDir>$(MSBuildThisFileDirectory)..\AppProxy.Bridge\bin\$(Configuration)\$(TargetFramework)\</BridgeBinDir>
    </PropertyGroup>
    <MSBuild Projects="$(BridgeProject)" Properties="Configuration=$(Configuration)" BuildInParallel="true" />
    <ItemGroup>
      <BridgeArtifacts Include="$(BridgeBinDir)AppProxy.Bridge.exe" Condition="Exists('$(BridgeBinDir)AppProxy.Bridge.exe')" />
      <BridgeArtifacts Include="$(BridgeBinDir)AppProxy.Bridge.dll" Condition="Exists('$(BridgeBinDir)AppProxy.Bridge.dll')" />
      <BridgeArtifacts Include="$(BridgeBinDir)AppProxy.Bridge.deps.json" Condition="Exists('$(BridgeBinDir)AppProxy.Bridge.deps.json')" />
      <BridgeArtifacts Include="$(BridgeBinDir)AppProxy.Bridge.runtimeconfig.json" Condition="Exists('$(BridgeBinDir)AppProxy.Bridge.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(BridgeArtifacts)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(BridgeArtifacts)' != ''" />
  </Target>

</Project>
