<Project>
  <PropertyGroup>
    <AppProxyRoot>$(MSBuildThisFileDirectory)</AppProxyRoot>
    <AppProxyArtifactsDir>$(AppProxyRoot)artifacts\</AppProxyArtifactsDir>
    <AppProxyVersion Condition="'$(AppProxyVersion)' == ''">1.0.0</AppProxyVersion>
    <AppProxyVersionMajor>$([System.Version]::Parse('$(AppProxyVersion)').Major)</AppProxyVersionMajor>
    <AppProxyVersionMinor>$([System.Version]::Parse('$(AppProxyVersion)').Minor)</AppProxyVersionMinor>
    <AppProxyVersionPatch Condition="$([System.Version]::Parse('$(AppProxyVersion)').Build) &gt;= 0">$([System.Version]::Parse('$(AppProxyVersion)').Build)</AppProxyVersionPatch>
    <AppProxyVersionPatch Condition="'$(AppProxyVersionPatch)' == ''">0</AppProxyVersionPatch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <Version>$(AppProxyVersion)</Version>
    <AssemblyVersion>$(AppProxyVersion).0</AssemblyVersion>
    <FileVersion>$(AppProxyVersion).0</FileVersion>
    <Product>AppProxy</Product>
    <Company>AppProxy</Company>
    <Authors>AppProxy</Authors>
  </PropertyGroup>
</Project>
